{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.mirae/answer-response.schema.json",
  "title": "DisclosureAgentAnswer",
  "type": "object",
  "additionalProperties": false,
  "required": ["question_id", "question", "answer", "claims", "calculations", "citations", "limitations", "confidence", "validation"],
  "properties": {
    "question_id": {"type": "string"},
    "question": {"type": "string"},
    "retrieved_context": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "record_id", "content", "citation"],
        "properties": {
          "kind": {"enum": ["cell", "text", "table", "event", "event_field", "correction", "investment_plan", "financing", "contract", "contract_termination", "contract_lifecycle", "business_evidence", "business_overview", "business_profile", "business_revenue_mix"]},
          "record_id": {"type": ["string", "null"]},
          "content": {"type": "string"},
          "citation": {
            "type": "object",
            "properties": {
              "doc_id": {"type": ["string", "null"]},
              "corp_name": {"type": ["string", "null"]},
              "report_nm": {"type": ["string", "null"]},
              "rcept_no": {"type": ["string", "null"]},
              "rcept_dt": {"type": ["string", "null"]},
              "section_path": {"type": ["string", "null"]},
              "table_title": {"type": ["string", "null"]},
              "row_label": {"type": ["string", "null"]},
              "column_path": {"type": ["string", "null"]},
              "original_text": {"type": ["string", "null"]},
              "unit_raw": {"type": ["string", "null"]}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "think_trace": {
      "type": "object",
      "required": ["steps", "query_plan", "note"],
      "properties": {
        "steps": {"type": "array", "items": {"type": "string"}},
        "query_plan": {"type": "object"},
        "note": {"type": "string"}
      }
    },
    "answer": {"type": "string"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "text", "claim_type", "evidence_ids", "verified"],
        "properties": {
          "claim_id": {"type": "string"},
          "text": {"type": "string"},
          "claim_type": {"enum": ["extracted_fact", "calculated_fact"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "verified": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "calculations": {"type": "array", "items": {"type": "object"}},
    "citations": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "object"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "validation": {
      "type": "object",
      "required": ["passed", "checks", "requirements", "grounding", "action"],
      "properties": {
        "passed": {"type": "boolean"},
        "checks": {"type": "array", "items": {"type": "object"}},
        "requirements": {"type": "object"},
        "grounding": {"type": "object"},
        "action": {"enum": ["allow", "review", "blocked", "clarify", "limit"]}
      },
      "additionalProperties": true
    }
  }
}
